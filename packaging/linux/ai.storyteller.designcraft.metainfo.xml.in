<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.wooshin.tools.layout</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>우신 출판</name>
  <name xml:lang="en">Wooshin Layout</name>
  <summary>Lay out magazines, books and print documents</summary>
  <developer id="com.wooshin">
    <name>Wooshin</name>
  </developer>
  <description>
    <p>
      Wooshin Layout is a page layout. Lay out magazines, books and print documents
    </p>
  </description>
  <launchable type="desktop-id">com.wooshin.tools.layout.desktop</launchable>
  <icon type="stock">com.wooshin.tools.layout</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/yeo1220/designcraft</url>
  <url type="bugtracker">https://github.com/yeo1220/designcraft/issues</url>
  <url type="help">https://github.com/yeo1220/designcraft</url>
  <url type="contact">https://woo-shin.com/messenger</url>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>image editor</keyword>
    <keyword>psd</keyword>
    <keyword>layers</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#071f3b</color>
    <color type="primary" scheme_preference="dark">#071f3b</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>wooshin-layout</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
