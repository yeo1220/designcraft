<?xml version="1.0" encoding="utf-8"?>
<!--
  Wooshin Layout MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build designcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.pcraft` owned by Wooshin Layout,
  and Wooshin Layout offered under "Open with" for PSD/PSB and the image formats it reads (without
  taking over the user's default app for them).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="우신 출판"
      Manufacturer="Wooshin"
      Version="$(var.Version)"
      UpgradeCode="5D57EA82-941E-5A06-A7D1-D5FDA3E76B7F"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Wooshin Layout page layout and publishing" Manufacturer="Wooshin" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Wooshin Layout is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DesigncraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DesigncraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/yeo1220/designcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/yeo1220/designcraft" />
    <Property Id="ARPHELPLINK" Value="https://woo-shin.com/messenger" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="WooshinLayout" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Wooshin Layout" Level="1">
      <ComponentGroupRef Id="DesigncraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="DesigncraftFiles" Directory="INSTALLFOLDER">
      <Component Id="DesigncraftApp" Guid="150A8635-4885-5998-BCB0-BBD33C2099D5">
        <File Id="DesigncraftExe" Source="$(var.BinDir)\wooshin-layout.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="우신 출판"
              Description="Wooshin Layout page layout and publishing" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="DesigncraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\wooshin-layout.exe" Value="[#DesigncraftExe]" Type="string" />
      </Component>

      <Component Id="DesigncraftCli">
        <File Id="DesigncraftCliExe" Source="$(var.BinDir)\wooshin-layout-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
